{
  "name": "bach-ngan-bao-gia",
  "version": "2.0.0-alpha.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=2 \"tests/**/*.test.ts\" \"src/**/*.test.ts\"",
    "test:perf": "node --import tsx --test \"tests/perf/*.perf.ts\"",
    "test:db": "node --import tsx --test --test-concurrency=2 \"tests/db/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "docs:data-model": "node --import tsx scripts/gen-data-model-doc.ts",
    "docs:ncc": "node --import tsx scripts/gen-ncc-actions-doc.ts",
    "bootstrap:manager": "node --import tsx scripts/bootstrap-manager.ts",
    "ui:build": "node --import tsx scripts/build-trial-ui.ts",
    "ui:dev": "node --import tsx scripts/dev-trial-ui.ts",
    "ui:demo": "node --import tsx scripts/build-trial-demo.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "@supabase/supabase-js": "2.117.2",
    "drizzle-orm": "0.45.2",
    "fflate": "0.8.2",
    "postgres": "3.4.7",
    "saxes": "6.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "22.19.19",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.25.12",
    "pdfjs-dist": "6.5.438",
    "tsx": "^4.19.0",
    "typescript": "5.9.3"
  }
}
