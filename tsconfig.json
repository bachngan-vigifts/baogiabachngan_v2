{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true,
    "allowImportingTsExtensions": true, "noEmit": true, "resolveJsonModule": true,
    "types": ["node"], "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "tests", "drizzle.config.ts"]
}
